generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SUPER_ADMIN
  RESTAURANT
  GROCERY
  DELIVERY
}

enum StoreType {
  RESTAURANT
  GROCERY
}

enum OrderType {
  FOOD
  GROCERY
}

enum OrderStatus {
  PLACED
  ACCEPTED
  CONFIRMED
  PREPARING
  PACKING
  READY_FOR_PICKUP
  RIDER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentMethod {
  COD
  UPI
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DeliveryAssignmentStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  DELIVERED
  REJECTED
}

enum WalletTransactionType {
  DELIVERY_EARNING
  WITHDRAWAL_REQUEST
  WITHDRAWAL_PAID
  ADJUSTMENT
}

enum NotificationType {
  ORDER
  SYSTEM
  PAYMENT
  INVENTORY
}

enum BannerPlacement {
  HOME
  FOOD
  GROCERY
}

model User {
  id                       String                   @id @default(cuid())
  name                     String
  email                    String?                  @unique
  phone                    String?                  @unique
  passwordHash             String
  role                     UserRole                 @default(CUSTOMER)
  isActive                 Boolean                  @default(true)
  lastLoginAt              DateTime?
  addresses                Address[]
  stores                   Store[]                  @relation("StoreOwner")
  orders                   Order[]                  @relation("CustomerOrders")
  deliveries               DeliveryAssignment[]    @relation("DeliveryRider")
  cart                     Cart?
  couponUsages             CouponUsage[]
  notifications            Notification[]
  walletTransactions       RiderWalletTransaction[] @relation("RiderWallet")
  adminLogs                AdminActivityLog[]       @relation("AdminActor")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([role, isActive])
  @@index([createdAt])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  recipient   String
  phone       String
  line1       String
  line2       String?
  landmark    String?
  city        String
  state       String
  pincode     String
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  isDefault   Boolean  @default(false)
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isDefault])
  @@index([pincode])
}

model ServiceablePincode {
  id                   String   @id @default(cuid())
  pincode              String   @unique
  city                 String
  state                String
  deliveryFeePaise     Int      @default(2000)
  minimumOrderPaise    Int      @default(10000)
  estimatedDeliveryMin Int      @default(30)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive, pincode])
}

model Store {
  id                       String             @id @default(cuid())
  ownerId                  String
  owner                    User               @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  type                     StoreType
  name                     String
  slug                     String             @unique
  description              String?
  phone                    String
  email                    String?
  address                  String
  pincode                  String
  imageUrl                 String?
  coverImageUrl            String?
  minimumOrderPaise        Int                @default(10000)
  deliveryFeePaise         Int                @default(2000)
  averagePrepMins          Int                @default(25)
  rating                   Decimal            @default(4.5) @db.Decimal(2, 1)
  isOpen                   Boolean            @default(true)
  isApproved               Boolean            @default(false)
  categories               Category[]
  products                 Product[]
  orders                   Order[]
  carts                    Cart[]
  openingHours             StoreOpeningHour[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([type, isOpen, isApproved])
  @@index([pincode])
  @@index([ownerId])
}

model StoreOpeningHour {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  opensAt     String
  closesAt    String
  isClosed    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, dayOfWeek])
}

model Category {
  id          String     @id @default(cuid())
  storeId     String?
  store       Store?     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  type        StoreType
  name        String
  slug        String
  imageUrl    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([storeId, slug])
  @@index([type, isActive, sortOrder])
  @@index([parentId])
}

model Product {
  id          String           @id @default(cuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  slug        String
  description String?
  imageUrl    String?
  isVeg       Boolean?
  isActive    Boolean          @default(true)
  variants    ProductVariant[]
  addons      FoodAddon[]
  orderItems  OrderItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, categoryId, isActive])
  @@index([name])
}

model ProductVariant {
  id           String      @id @default(cuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  sku          String      @unique
  unit         String
  mrpPaise     Int
  salePricePaise Int
  stock        Int         @default(0)
  lowStockAt   Int         @default(5)
  expiryDate   DateTime?
  isAvailable  Boolean     @default(true)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([productId, isAvailable])
  @@index([stock])
  @@index([expiryDate])
}

model FoodAddon {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  pricePaise  Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId, isAvailable])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String?
  store     Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([storeId])
}

model CartItem {
  id               String         @id @default(cuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity         Int
  selectedAddons   Json           @default("[]")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

model Order {
  id                   String               @id @default(cuid())
  orderNumber          String               @unique
  invoiceNumber        String               @unique
  type                 OrderType
  status               OrderStatus          @default(PLACED)
  statusHistory        Json                 @default("[]")
  customerId           String
  customer             User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  storeId              String
  store                Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  addressId            String
  address              Address              @relation(fields: [addressId], references: [id], onDelete: Restrict)
  subtotalPaise        Int
  discountPaise        Int                  @default(0)
  deliveryFeePaise     Int
  taxPaise             Int                  @default(0)
  totalPaise           Int
  paymentMethod        PaymentMethod
  paymentStatus        PaymentStatus        @default(PENDING)
  notes                String?
  cancellationReason   String?
  cancelledAt          DateTime?
  deliveredAt          DateTime?
  items                OrderItem[]
  payment              Payment?
  delivery             DeliveryAssignment?
  couponUsage          CouponUsage?
  walletTransactions   RiderWalletTransaction[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([customerId, createdAt])
  @@index([storeId, status, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
}

model OrderItem {
  id                 String         @id @default(cuid())
  orderId            String
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId          String
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName        String
  variantName        String
  unitPricePaise     Int
  quantity           Int
  addonTotalPaise    Int            @default(0)
  totalPaise         Int
  addons             Json           @default("[]")

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String?
  providerRef   String?
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amountPaise   Int
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

model Coupon {
  id                String       @id @default(cuid())
  code              String       @unique
  description       String?
  discountType      DiscountType
  discountValue     Int
  maxDiscountPaise  Int?
  minimumOrderPaise Int          @default(0)
  usageLimit        Int?
  perUserLimit      Int          @default(1)
  startsAt          DateTime
  expiresAt         DateTime
  isActive          Boolean      @default(true)
  usages            CouponUsage[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([isActive, startsAt, expiresAt])
}

model CouponUsage {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountPaise Int
  createdAt     DateTime @default(now())

  @@unique([couponId, userId, orderId])
  @@index([couponId, userId])
}

model DeliveryAssignment {
  id               String                   @id @default(cuid())
  orderId          String                   @unique
  order            Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId          String
  rider            User                     @relation("DeliveryRider", fields: [riderId], references: [id], onDelete: Restrict)
  status           DeliveryAssignmentStatus @default(ASSIGNED)
  deliveryOtpHash  String
  earningPaise     Int                      @default(2000)
  codCollectedPaise Int                     @default(0)
  acceptedAt       DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([riderId, status, createdAt])
  @@index([riderId, deliveredAt])
}

model RiderWalletTransaction {
  id          String                @id @default(cuid())
  riderId     String
  rider       User                  @relation("RiderWallet", fields: [riderId], references: [id], onDelete: Restrict)
  orderId     String?
  order       Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type        WalletTransactionType
  amountPaise Int
  note        String?
  createdAt   DateTime              @default(now())

  @@index([riderId, createdAt])
  @@index([orderId])
}

model Banner {
  id          String          @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  linkUrl     String?
  placement   BannerPlacement @default(HOME)
  sortOrder   Int             @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model AdminActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AdminActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
